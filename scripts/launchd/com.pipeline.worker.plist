<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Pipeline worker: scrapes supplier pages for the app whenever it asks.
       Runs from ~/.pipeline-worker, NOT from the repo: ~/Desktop is iCloud-synced
       and a background process can be handed empty files there after a reboot.
       Install (once):
         mkdir -p ~/.pipeline-worker && cp scripts/launchd/run-worker.sh scripts/local-worker.py scripts/supplier-scrape.py ~/.pipeline-worker/
         cp scripts/launchd/com.pipeline.worker.plist ~/Library/LaunchAgents/
         launchctl load ~/Library/LaunchAgents/com.pipeline.worker.plist
       Stop:   launchctl unload ~/Library/LaunchAgents/com.pipeline.worker.plist
       Logs:   ~/Library/Logs/pipeline-worker.log -->
  <key>Label</key><string>com.pipeline.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/ricardsraksa/.pipeline-worker/run-worker.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/ricardsraksa/Library/Logs/pipeline-worker.log</string>
  <key>StandardErrorPath</key><string>/Users/ricardsraksa/Library/Logs/pipeline-worker.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/Users/ricardsraksa/.local/bin</string>
  </dict>
</dict>
</plist>
